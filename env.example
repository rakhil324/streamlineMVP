# Database
DATABASE_URL="postgresql://user:password@localhost:5432/simplify_mvp?schema=public"

# NextAuth
AUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Supabase (for file storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# LLM API Configuration (choose one provider)
OPENAI_API_KEY="your_openai_api_key_here"
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o"

# OR for Anthropic
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"
# LLM_PROVIDER="anthropic"
# LLM_MODEL="claude-3-opus-20240229"

# OR for Google Gemini (FREE)
# GEMINI_API_KEY="your_gemini_api_key_here"
# LLM_PROVIDER="gemini"
# LLM_MODEL="gemini-pro"

# OR for Groq (FREE - Recommended)
# GROQ_API_KEY="your_groq_api_key_here"
# LLM_PROVIDER="groq"
# LLM_MODEL="llama-3.1-8b-instant"

# OR for Hugging Face (FREE)
# HUGGINGFACE_API_KEY="your_hf_token_here"
# LLM_PROVIDER="huggingface"
# LLM_MODEL="mistralai/Mistral-7B-Instruct-v0.2"

# Encryption
# This is automatically generated, but you can set a custom one
ENCRYPTION_KEY=""

