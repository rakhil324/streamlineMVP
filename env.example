# Database (PostgreSQL via Supabase)
# Get this from Supabase Dashboard -> Settings -> Database -> Connection String (URI)
# DATABASE_URL: Session Pooler (port 6543) - for runtime queries
#   IMPORTANT: Add ?pgbouncer=true to the end of the URL for Supabase pooler
# DIRECT_URL: Direct Connection (port 5432) - for migrations and schema changes
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional - for social login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Supabase (for database and file storage)
# Get these from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# LLM API Configuration (choose one provider)
OPENAI_API_KEY="your_openai_api_key_here"
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o"

# OR for Anthropic
# ANTHROPIC_API_KEY="your_anthropic_api_key_here"
# LLM_PROVIDER="anthropic"
# LLM_MODEL="claude-3-opus-20240229"

# OR for Google Gemini (FREE)
# GEMINI_API_KEY="your_gemini_api_key_here"
# LLM_PROVIDER="gemini"
# LLM_MODEL="gemini-pro"

# OR for Groq (FREE - Recommended)
# GROQ_API_KEY="your_groq_api_key_here"
# LLM_PROVIDER="groq"
# LLM_MODEL="llama-3.1-8b-instant"

# OR for Hugging Face (FREE)
# HUGGINGFACE_API_KEY="your_hf_token_here"
# LLM_PROVIDER="huggingface"
# LLM_MODEL="mistralai/Mistral-7B-Instruct-v0.2"

# Encryption
# This is automatically generated, but you can set a custom one
ENCRYPTION_KEY=""

